{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.md",
    "style": "markdown",
    "compress": true,
    "removeEmptyLines": true,
    "topFilesLength": 15,
    "showLineNumbers": false
  },
  "include": ["**/*"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "benchmark/runs/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/dist/**",
      "**/build/**",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.pdf"
    ]
  },
  "security": { "enableSecurityCheck": true }
}